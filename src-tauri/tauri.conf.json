{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sticky-notes",
  "version": "0.1.0",
  "identifier": "com.sticky.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "便签",
        "label": "main",
        "width": 260,
        "height": 320,
        "minWidth": 180,
        "minHeight": 100,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
